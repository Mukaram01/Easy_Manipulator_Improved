          <geometry><box><size>0.01 0.14 0.10</size></box></geometry>
          <material><diffuse>0.18 0.22 0.30 1</diffuse></material>
        </visual>
        <visual name="wall_y_minus_visual">
          <pose>0.45 0.155 0.145 0 0 0</pose>
          <geometry><box><size>0.24 0.01 0.10</size></box></geometry>
