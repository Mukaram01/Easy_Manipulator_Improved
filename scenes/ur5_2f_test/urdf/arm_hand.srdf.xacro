<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5_test">

  <xacro:include filename="$(find ur5_moveit_config)/config/ur5.srdf.xacro" />

  <xacro:include filename="$(find robotiq_85_moveit_config)/config/robotiq_85_gripper.srdf.xacro" />

  <xacro:ur5/>

  <xacro:robotiq_85_gripper/>

  <!-- Only the rigid mounting interface is exempted here.  The gripper
       profile supplies its own adjacent-link pairs; broad exemptions against
       the arm would hide a real self-collision. -->
  <disable_collisions link1="gripper_base_link" link2="tool0" reason="Never" />
  <!-- Explicit rigid adapter contact; this is the single mount exemption and
       does not broaden the arm's self-collision matrix. -->
  <disable_collisions link1="gripper_base_link" link2="wrist_3_link" reason="Adjacent" />


</robot>
