# External dependencies - use official repos (ROS2 Humble compatible)
repositories:
  ros_industrial_cmake_boilerplate:
    type: git
    url: https://github.com/ros-industrial/ros_industrial_cmake_boilerplate
    version: master
  tesseract_external:
    type: git
    url: https://github.com/ros-industrial-consortium/tesseract_ext
    version: master
  descartes_light:
    type: git
    url: https://github.com/swri-robotics/descartes_light
    version: master
  opw_kinematics:
    type: git
    url: https://github.com/Jmeyer1292/opw_kinematics
    version: master
  ifopt:
    type: git
    url: https://github.com/ethz-adrl/ifopt
    version: master
  boost_plugin_loader:
    type: git
    url: https://github.com/tesseract-robotics/boost_plugin_loader
    version: 0.4.3
  ruckig:
    type: git
    url: https://github.com/pantor/ruckig.git
    version: 37b6e7a  # v0.15.3; keep Humble/Jammy builds on the C++17-era baseline (no <format> dependency)
  tesseract:
    type: git
    url: https://github.com/tesseract-robotics/tesseract
    version: master
  tesseract_planning:
    type: git
    url: https://github.com/tesseract-robotics/tesseract_planning
    version: master
  trajopt:
    type: git
    url: https://github.com/tesseract-robotics/trajopt
    version: master
  tesseract_ros2:
    type: git
    url: https://github.com/tesseract-robotics/tesseract_ros2
    version: master
  tesseract_qt:
    type: git
    url: https://github.com/tesseract-robotics/tesseract_qt
    version: master
