<?xml version="1.0"?>
<package format="2">
  <name>tesseract_motion_planners</name>
  <version>0.33.1</version>
  <description>This contains tesseract planners</description>

  <maintainer email="levi.armstrong@swri.org">Levi Armstrong</maintainer>
  <license>Apache 2.0</license>
  <author >Levi Armstrong</author>

  <!-- Following recommendations of REP 136 -->
  <buildtool_depend>cmake</buildtool_depend>

  <build_depend>cereal</build_depend>
  <exec_depend>cereal</exec_depend>
  <depend>tesseract_common</depend>
  <depend>tesseract_environment</depend>
  <depend>tesseract_kinematics</depend>
  <depend>tesseract_command_language</depend>
  <build_depend>ros_industrial_cmake_boilerplate</build_depend>
  <build_depend>roslib</build_depend>
  <exec_depend>roslib</exec_depend>

  <depend>descartes_light</depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <depend>libconsole-bridge-dev</depend>
  <build_depend>libboost-graph-dev</build_depend>
  <exec_depend>libboost-graph-dev</exec_depend>
  <depend>ompl</depend>
  <depend>trajopt</depend>
  <build_depend>trajopt_ifopt</build_depend>
  <exec_depend>trajopt_ifopt</exec_depend>
  <depend>trajopt_sco</depend>
  <depend>trajopt_sqp</depend>
  <build_depend>openmp</build_depend>
  <exec_depend>openmp</exec_depend>
  <test_depend>gtest</test_depend>
  <test_depend>tesseract_support</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
