<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera_stand">
  <xacro:macro name="camera_stand" params="prefix parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${prefix}camera_stand_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://workcell_builder/assets/environment/camera_stand_description/meshes/camera_stand.stl" scale="1 1 1"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.08 0.08 1.2"/></geometry></collision>
    </link>
  </xacro:macro>
</robot>
