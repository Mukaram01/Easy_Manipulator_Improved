<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="safety_fence_panel">
  <xacro:macro name="safety_fence_panel" params="prefix parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${prefix}safety_fence_panel_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://workcell_builder/assets/environment/safety_fence_panel_description/meshes/safety_fence_panel.stl" scale="1 1 1"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="1.2 0.05 1.8"/></geometry></collision>
    </link>
  </xacro:macro>
</robot>
