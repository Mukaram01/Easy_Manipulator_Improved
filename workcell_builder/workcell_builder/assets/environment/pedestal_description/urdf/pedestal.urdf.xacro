<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pedestal">
  <xacro:macro name="pedestal" params="prefix parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${prefix}pedestal_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://workcell_builder/assets/environment/pedestal_description/meshes/pedestal.stl" scale="1 1 1"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.4 0.4 0.7"/></geometry></collision>
    </link>
  </xacro:macro>
</robot>
