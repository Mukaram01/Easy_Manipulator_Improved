<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tote_box">
  <xacro:macro name="tote_box" params="prefix parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${prefix}tote_box_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://workcell_builder/assets/environment/tote_box_description/meshes/tote_box.stl" scale="1 1 1"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.6 0.4 0.28"/></geometry></collision>
    </link>
  </xacro:macro>
</robot>
