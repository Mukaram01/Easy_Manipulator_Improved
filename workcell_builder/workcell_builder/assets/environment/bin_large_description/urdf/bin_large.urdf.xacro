<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bin_large">
  <xacro:macro name="bin_large" params="prefix parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${prefix}bin_large_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://workcell_builder/assets/environment/bin_large_description/meshes/bin_large.stl" scale="1 1 1"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.7 0.5 0.35"/></geometry></collision>
    </link>
  </xacro:macro>
</robot>
