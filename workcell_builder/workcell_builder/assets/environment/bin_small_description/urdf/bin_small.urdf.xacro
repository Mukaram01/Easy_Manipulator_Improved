<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bin_small">
  <xacro:macro name="bin_small" params="prefix parent xyz:='0 0 0' rpy:='0 0 0'">
    <link name="${prefix}bin_small_link">
      <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://workcell_builder/assets/environment/bin_small_description/meshes/bin_small.stl" scale="1 1 1"/></geometry></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.4 0.3 0.2"/></geometry></collision>
    </link>
  </xacro:macro>
</robot>
