@@ -0,0 +1,87 @@
+#pragma once
+#include <dart/constraint/ConstraintBase.hpp>
+#include <dart/constraint/JointConstraint.hpp>
+#include <dart/dynamics/BodyNode.hpp>
+#include <dart/dynamics/Joint.hpp>
+#include <dart/dynamics/Skeleton.hpp>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+
+namespace workcell {
+// Passive bilateral relation. Equal and opposite generalized impulses transfer
+// load to the driven joint. Independent actuator force limits stay unchanged.
+class JointCouplingConstraint : public dart::constraint::ConstraintBase {
+ public:
+  JointCouplingConstraint(dart::dynamics::Joint* follower,
+                          dart::dynamics::Joint* driver,double multiplier)
+      : follower_(follower),driver_(driver),multiplier_(multiplier) {
+    if (!follower_ || !driver_ || follower_==driver_
+        || follower_->getNumDofs()!=1 || driver_->getNumDofs()!=1
+        || follower_->getSkeleton()!=driver_->getSkeleton()
+        || follower_->getType()!=driver_->getType()
+        || !std::isfinite(multiplier_) || std::abs(multiplier_)!=1.)
+      throw std::invalid_argument("unsupported passive mimic relation");
+    requireDynamic();
+    mDim=1;
+  }
+  const std::string& getType() const override {
+    static const std::string type="WorkcellPassiveJointCoupling";return type;
+  }
+  bool isActive() const override {return true;}
+  dart::dynamics::SkeletonPtr getRootSkeleton() const override {
+    // Native rows read the immediate representative of the contact union.
+    // Normalize this skeleton to the final root before grouping; separate
+    // groups can otherwise clear each other's solved coupling impulses.
+    auto skeleton=follower_->getSkeleton();
+    auto root=dart::constraint::ConstraintBase::getRootSkeleton(skeleton);
+    skeleton->mUnionRootSkeleton=root;
+    return root;
+  }
+ protected:
+  void update() override {
+    requireDynamic();
+    position_error_=follower_->getPosition(0)-multiplier_*driver_->getPosition(0);
+    velocity_error_=follower_->getVelocity(0)-multiplier_*driver_->getVelocity(0);
+    if (!std::isfinite(position_error_) || !std::isfinite(velocity_error_))
+      throw std::runtime_error("nonfinite passive mimic state");
+  }
+  void getInformation(dart::constraint::ConstraintInfo* info) override {
+    const double correction=dart::constraint::JointConstraint::getErrorReductionParameter()
+        *position_error_*info->invTimeStep;
+    const double bound=dart::constraint::JointConstraint::getMaxErrorReductionVelocity();
+    info->b[0]=-velocity_error_-std::max(-bound,std::min(bound,correction));
+    info->lo[0]=-std::numeric_limits<double>::infinity();
+    info->hi[0]=std::numeric_limits<double>::infinity();
+    info->findex[0]=-1;info->x[0]=0.;
+  }
+  void applyUnitImpulse(std::size_t index) override {
+    if (index!=0)throw std::out_of_range("passive mimic constraint row");
+    auto skeleton=follower_->getSkeleton();skeleton->clearConstraintImpulses();
+    follower_->setConstraintImpulse(0,1.);driver_->setConstraintImpulse(0,-multiplier_);
+    skeleton->updateBiasImpulse(follower_->getChildBodyNode(),Eigen::Vector6d::Zero(),
+                               driver_->getChildBodyNode(),Eigen::Vector6d::Zero());
+    skeleton->updateVelocityChange();
+    follower_->setConstraintImpulse(0,0.);driver_->setConstraintImpulse(0,0.);
+  }
+  void getVelocityChange(double* velocity,bool withCfm) override {
+    velocity[0]=follower_->getSkeleton()->isImpulseApplied()
+        ? follower_->getVelocityChange(0)-multiplier_*driver_->getVelocityChange(0):0.;
+    if (withCfm)velocity[0]*=1.+dart::constraint::JointConstraint::getConstraintForceMixing();
+  }
+  void excite() override {follower_->getSkeleton()->setImpulseApplied(true);}
+  void unexcite() override {follower_->getSkeleton()->setImpulseApplied(false);}
+  void applyImpulse(double* lambda) override {
+    follower_->setConstraintImpulse(0,follower_->getConstraintImpulse(0)+lambda[0]);
+    driver_->setConstraintImpulse(0,driver_->getConstraintImpulse(0)-multiplier_*lambda[0]);
+  }
+ private:
+  void requireDynamic() const {
+    if (!follower_->getSkeleton()->isMobile() || follower_->isKinematic() || driver_->isKinematic())
+      throw std::runtime_error("passive mimic requires mobile skeleton and dynamic actuator modes");
+  }
+  dart::dynamics::Joint* follower_;
+  dart::dynamics::Joint* driver_;
+  double multiplier_,position_error_=0.,velocity_error_=0.;
+};
+}
