+#pragma once
+#include <dart/collision/bullet/BulletCollisionDetector.hpp>
+#include <dart/collision/CollisionResult.hpp>
+#include <cmath>
+#include <memory>
+#include <stdexcept>
+namespace workcell {
+// Bullet retains manifold points across small positive separations. DART 6.12
+// converts these to negative depths and excludes them from solver rows, but
+// keeps them in its reported contacts. Physical telemetry must exclude them.
+class TouchingBulletContacts : public dart::collision::BulletCollisionDetector {
+ public:
+  TouchingBulletContacts()=default;
+  std::shared_ptr<dart::collision::CollisionDetector> cloneWithoutCollisionObjects() const override {
+    return std::make_shared<TouchingBulletContacts>();
+  }
+  bool collide(dart::collision::CollisionGroup* group,const dart::collision::CollisionOption& option,dart::collision::CollisionResult* result) override {
+    dart::collision::CollisionResult raw;
+    if(result)result->clear();if(!option.maxNumContacts)return false;
+    auto query=option;query.enableContact=true;
+    BulletCollisionDetector::collide(group,query,&raw);
+    return touching(raw,option.maxNumContacts,result);
+  }
+  bool collide(dart::collision::CollisionGroup*,dart::collision::CollisionGroup*,const dart::collision::CollisionOption&,dart::collision::CollisionResult*) override {
+    // Stage-A physics queries one complete world group. DART 6.12's stock
+    // two-group implementation retains a detector/group ownership cycle.
+    // Reject this unsupported entry point instead of creating that cycle.
+    throw std::logic_error("physical Bullet contacts require one complete world group");
+  }
+ private:
+  static bool touching(const dart::collision::CollisionResult& raw,std::size_t maximum,dart::collision::CollisionResult* result){
+    bool separated=false;
+    for(const auto& c:raw.getContacts()){
+      if(!std::isfinite(c.penetrationDepth)||!c.point.allFinite()||!c.normal.allFinite())
+        throw std::runtime_error("nonfinite Bullet physical contact");
+      separated=separated||c.penetrationDepth<0.;
+    }
+    if(separated&&raw.getNumContacts()==maximum)
+      throw std::runtime_error("physical Bullet contact query budget saturated by separated cache points");
+    std::size_t kept=0;
+    for(const auto& c:raw.getContacts()){
+      if(c.penetrationDepth<0.)continue;
+      if(result)result->addContact(c);
+      ++kept;
+    }
+    return kept!=0;
+  }
+};
+}
