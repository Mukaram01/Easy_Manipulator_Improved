+          contact.normal = Eigen::Vector3d(c.normal[0], c.normal[1], c.normal[2]);
+          contact.penetrationDepth = c.depth;
+          if (!std::isfinite(c.depth) || c.depth < 0 || !contact.point.allFinite() ||
+              !contact.normal.allFinite())
+            throw std::runtime_error("invalid physical BOX contact");
+          result.addContact(contact);
+        }
+      }
+  }
+  static bool touching(const dart::collision::CollisionResult& raw, std::size_t maximum,
+                       dart::collision::CollisionResult* result) {
+    bool separated = false;
+    for (const auto& c : raw.getContacts()) {
+      if (!std::isfinite(c.penetrationDepth) || !c.point.allFinite() || !c.normal.allFinite())
+        throw std::runtime_error("nonfinite Bullet physical contact");
+      separated = separated || c.penetrationDepth < 0.;
+    }
+    if (separated && raw.getNumContacts() == maximum)
+      throw std::runtime_error(
+          "physical Bullet contact query budget saturated by separated cache points");
+    std::size_t kept = 0;
+    for (const auto& c : raw.getContacts()) {
+      if (c.penetrationDepth < 0.) continue;
+      if (result) result->addContact(c);
+      ++kept;
+    }
+    return kept != 0;
+  }
+  // Use DART's existing ODE initialization lifetime; no secondary groups or
+  // borrowed ODE collision objects. Returned contacts own no temporary geometry.
+  std::shared_ptr<dart::collision::OdeCollisionDetector> ode;
+};
+}  // namespace workcell
