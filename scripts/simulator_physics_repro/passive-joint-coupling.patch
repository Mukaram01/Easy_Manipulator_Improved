+namespace workcell {
+// Keep the original Bullet collision objects and filter semantics. BOX pairs
+// use double precision geometry; all other pairs retain Bullet manifolds.
+class PhysicalBulletGroup : public dart::collision::BulletCollisionGroup {
+ public:
+  using BulletCollisionGroup::BulletCollisionGroup;
+  std::vector<dart::collision::CollisionObject*> objects() const {
+    std::vector<dart::collision::CollisionObject*> result;
+    const auto& objects = getBulletCollisionWorld()->getCollisionObjectArray();
+    for (int i = 0; i < objects.size(); ++i) {
+      auto* object =
+          static_cast<dart::collision::BulletCollisionObject*>(objects[i]->getUserPointer());
+      if (!object || !hasShapeFrame(object->getShapeFrame()))
+        throw std::runtime_error("invalid physical Bullet group member");
+      result.push_back(object);
+    }
+    return result;
+  }
+};
+class TouchingBulletContacts : public dart::collision::BulletCollisionDetector {
+ public:
+  TouchingBulletContacts() : ode(dart::collision::OdeCollisionDetector::create()) {
+    static_assert(sizeof(dReal) == sizeof(double), "physical BOX contacts require double ODE");
+  }
+  std::shared_ptr<dart::collision::CollisionDetector> cloneWithoutCollisionObjects()
+      const override {
+    return std::make_shared<TouchingBulletContacts>();
+  }
+  using BulletCollisionDetector::createCollisionGroup;
+  std::unique_ptr<dart::collision::CollisionGroup> createCollisionGroup() override {
+    return std::make_unique<PhysicalBulletGroup>(shared_from_this());
+  }
+  bool collide(dart::collision::CollisionGroup* group,
+               const dart::collision::CollisionOption& option,
+               dart::collision::CollisionResult* result) override {
+    dart::collision::CollisionResult raw, physical;
+    if (result) result->clear();
+    if (!option.maxNumContacts) return false;
+    auto* actual = dynamic_cast<PhysicalBulletGroup*>(group);
+    if (!actual || group->getCollisionDetector().get() != this)
+      throw std::logic_error("physical Bullet group ownership mismatch");
+    auto query = option;
+    query.enableContact = true;
+    query.collisionFilter = std::make_shared<MeshFilter>(option.collisionFilter);
+    BulletCollisionDetector::collide(group, query, &raw);
+    touching(raw, option.maxNumContacts, &physical);
+    addBoxes(*actual, option, physical);
+    if (result) *result = physical;
+    return physical.getNumContacts() != 0;
+  }
+  bool collide(dart::collision::CollisionGroup*, dart::collision::CollisionGroup*,
+               const dart::collision::CollisionOption&,
+               dart::collision::CollisionResult*) override {
+    throw std::logic_error("physical Bullet contacts require one complete world group");
+  }
+
+ private:
+  static const dart::dynamics::BoxShape* box(const dart::collision::CollisionObject* object) {
+    return dynamic_cast<const dart::dynamics::BoxShape*>(object->getShape().get());
+  }
+  struct MeshFilter : dart::collision::CollisionFilter {
+    std::shared_ptr<dart::collision::CollisionFilter> original;
+    explicit MeshFilter(std::shared_ptr<dart::collision::CollisionFilter> filter)
+        : original(std::move(filter)) {}
+    bool ignoresCollision(const dart::collision::CollisionObject* a,
+                          const dart::collision::CollisionObject* b) const override {
+      return (box(a) && box(b)) || (original && original->ignoresCollision(a, b));
+    }
+  };
+  struct GeomDestroy {
+    void operator()(dxGeom* geom) const { dGeomDestroy(geom); }
+  };
+  struct BoxObject {
+    dart::collision::CollisionObject* original;
+    std::unique_ptr<dxGeom, GeomDestroy> geom;
+  };
+  void addBoxes(const PhysicalBulletGroup& group, const dart::collision::CollisionOption& option,
+                dart::collision::CollisionResult& result) {
+    if (!dAllocateODEDataForThread(dAllocateMaskAll))
+      throw std::runtime_error("ODE collision thread allocation failed");
+    std::vector<BoxObject> boxes;
+    for (auto* object : group.objects()) {
+      const auto* shape = box(object);
+      if (!shape) continue;
+      const auto& size = shape->getSize();
+      const auto& t = object->getTransform();
+      if (!size.allFinite() || (size.array() <= 0).any() || !t.matrix().allFinite())
+        throw std::runtime_error("invalid physical BOX geometry");
+      std::unique_ptr<dxGeom, GeomDestroy> geom(dCreateBox(nullptr, size.x(), size.y(), size.z()));
+      if (!geom) throw std::runtime_error("ODE BOX geometry allocation failed");
+      dGeomSetPosition(geom.get(), t.translation().x(), t.translation().y(), t.translation().z());
+      dMatrix3 rotation{};
+      for (int r = 0; r < 3; ++r)
+        for (int c = 0; c < 3; ++c) rotation[r * 4 + c] = t.linear()(r, c);
+      dGeomSetRotation(geom.get(), rotation);
+      boxes.push_back({object, std::move(geom)});
+    }
+    for (std::size_t i = 0; i < boxes.size(); ++i)
+      for (std::size_t j = i + 1; j < boxes.size(); ++j) {
+        auto& a = boxes[i];
+        auto& b = boxes[j];
+        if (option.collisionFilter &&
+            option.collisionFilter->ignoresCollision(a.original, b.original))
