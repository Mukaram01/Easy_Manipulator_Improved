+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+VIEWER = (ROOT / "workcell_studio_web/viewer/viewer.js").read_text()
+RENDERER = (ROOT / "workcell_studio_web/viewer/urdf_robot_renderer.js").read_text()
+QT = (ROOT / "workcell_builder/workcell_builder/gui/scene_preview_widget.cpp").read_text()
+
+
+def function_source(source: str, name: str) -> str:
+    start = source.index(f"function {name}(")
+    next_function = source.find("\nfunction ", start + 1)
+    return source[start:] if next_function < 0 else source[start:next_function]
+
+
+def declared_keys(source: str) -> list[str]:
+    return re.findall(r"^\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*[:,]", source, re.MULTILINE)
+
+
+def test_viewer_declares_canonical_diagnostic_contract():
+    assert "const DIAGNOSTIC_NAMING_CONTRACT" in VIEWER
+    assert "canonical_case: 'snake_case'" in VIEWER
+    assert "compatibility_boundary: 'qt_status_script'" in VIEWER
+    assert "function canonicalDiagnosticValue(value)" in VIEWER
+
+
+def test_readiness_payload_is_canonical_only():
+    source = function_source(VIEWER, "structuredWeb3dReadinessFields")
+    keys = declared_keys(source)
+    assert keys
+    assert not [key for key in keys if re.search(r"[A-Z]", key)]
+    assert keys.count("pending_required_loads") == 1
+    assert keys.count("final_lifecycle_state") == 1
+    emit = function_source(VIEWER, "emitWeb3dReadinessState")
+    assert "const canonicalDetail = canonicalDiagnosticValue(detail);" in emit
+    assert "const readinessMessage = canonicalDiagnosticValue" in emit
+    assert "finalLifecycleState" not in emit
+
+
+def test_failed_canvas_pick_emits_one_canonical_copy_per_field():
+    source = function_source(VIEWER, "failedCanvasPickDiagnostic")
+    keys = declared_keys(source)
+    expected = {
+        "hit_node_name", "registered_record_id", "pick_source",
+        "authoritative_physical_pick", "selection_owner_id",
+        "selection_owner_source", "edit_owner_id", "rejection_stage_reason",
+        "exclusion_ancestor_node", "exclusion_flag", "candidate_priority",
+        "raw_hit_count", "hit_object_names", "traversed_registered_identity",
+        "first_actionable_rejection_reason", "nearest_known_urdf_link_ancestor",
+        "hit_resolutions",
+    }
+    assert set(keys) == expected
+    assert all(keys.count(key) == 1 for key in expected)
+    assert not [key for key in keys if re.search(r"[A-Z]", key)]
+
+
+def test_rejected_pick_records_and_warnings_are_deduplicated():
+    assert "function stableDiagnosticSignature(kind, payload)" in VIEWER
+    assert "state.normalDiagnosticRecords" in VIEWER
+    assert "warnNormalDiagnosticOnce('failed_canvas_pick'" in VIEWER
+    assert "const signature = ['failed_canvas_pick'" not in VIEWER
+
+
+def test_diagnostic_producers_have_canonical_output_wrappers():
+    for name in (
+        "collectRenderedMeshDiagnostics", "collectAssemblyRenderDiagnostics",
+        "expandedUrdfVisualReadinessDiagnostics",
+    ):
+        assert f"function {name}Raw(" in VIEWER
+        wrapper = function_source(VIEWER, name)
+        assert f"canonicalDiagnosticValue({name}Raw())" in wrapper
+    assert "function updateViewerStatusRaw(" in VIEWER
+    assert "window.__WORKCELL_VIEWER_STATUS__ = status;" in function_source(VIEWER, "updateViewerStatus")
+    assert "function showErrorRaw(" in VIEWER
+    assert "canonicalDiagnosticValue(window.__WORKCELL_VIEWER_STATUS__)" in function_source(VIEWER, "showError")
+
+
+def test_renderer_emits_canonical_diagnostics_without_known_aliases():
+    aliases = (
+        "colladaZUpConsoleMessageCount", "robotPreviewLifecycleState",
+        "robotColladaRootNormalizationCount", "robotExpectedVisualCount",
+        "robotFailedVisualCount", "robotCompletedVisualCount",
+        "robotLoadingManagerComplete", "robotMatrixWorldParity",
+        "robotLinkWorldMatrices", "robotVisualWrapperWorldMatrices",
+        "robotDescendantRenderMeshDiagnostics", "robotRootLinkCount",
+        "robotRootLinks", "robotDisconnectedLinks", "robotDuplicateLinks",
+        "robotPreviewCanonicalFallbackUsed", "robotColladaMeshDiagnostics",
+        "robotColladaSummary", "robotMissingRequiredRobotVisualLinks",
+        "robotMissingRequiredToolVisualLinks", "robotExpectedRobotVisualLinks",
+        "robotExpectedToolVisualLinks", "robotMeshCallbacksComplete",
+    )
+    for alias in aliases:
+        assert re.search(rf"diagnostics\.{alias}\s*=", RENDERER) is None
+        assert re.search(rf"^\s*{alias}\s*:", RENDERER, re.MULTILINE) is None
+    assert "result.diagnostics = canonicalDiagnosticValue(result.diagnostics);" in RENDERER
+    assert "onRobotError?.(err, result.diagnostics)" in RENDERER
+    assert "source_url: sourceUrl || '', policy_reason: reason" in RENDERER
+
+
+def test_qt_status_script_is_narrow_and_preserves_status_fields():
+    start = QT.index('static const char kStatusScript[]')
+    end = QT.index(')JS";', start)
+    script = QT[start:end]
+    assert "External compatibility boundary" in script
+    assert "const readStatus = (canonicalKey, legacyKey, fallbackValue)" in script
+    pairs = re.findall(r"readStatus\('([a-z0-9_]+)', '([A-Za-z0-9]+)'", script)
+    assert pairs
+    assert len({canonical for canonical, _ in pairs}) == len(pairs)
+    required = {
+        "readiness_contract_version", "lifecycle_state", "status_sequence",
+        "builder_revision", "viewer_boot_state", "scene_name",
+        "source_web_scene_file", "scene_json_loaded",
+        "robot_preview_lifecycle_state", "scene_id",
+        "expected_physical_item_count", "rendered_physical_item_count",
+        "failed_required_item_count", "robot_status", "tool_status",
+        "environment_status", "camera_status", "pending_required_loads",
+        "final_lifecycle_state", "readiness_failure", "failed_stage",
+        "fatal_error", "fatal_stack",
+    }
+    assert required.issubset({canonical for canonical, _ in pairs} | {"lifecycle_state", "pending_required_loads"})
