index 00000000..7a591256
--- /dev/null
+++ b/tests/test_workcell_web3d_diagnostic_naming_contract.py
@@ -0,0 +1,112 @@
+from pathlib import Path
+import re
+
+ROOT = Path(__file__).resolve().parents[1]
+VIEWER = (ROOT / "workcell_studio_web/viewer/viewer.js").read_text()
+RENDERER = (ROOT / "workcell_studio_web/viewer/urdf_robot_renderer.js").read_text()
+QT = (ROOT / "workcell_builder/workcell_builder/gui/scene_preview_widget.cpp").read_text()
+
+
+def function_source(source: str, name: str) -> str:
+    start = source.index(f"function {name}(")
+    next_function = source.find("\nfunction ", start + 1)
+    return source[start:] if next_function < 0 else source[start:next_function]
+
+
+def declared_keys(source: str) -> list[str]:
+    return re.findall(r"^\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*[:,]", source, re.MULTILINE)
+
+
+def test_viewer_declares_canonical_diagnostic_contract():
+    assert "const DIAGNOSTIC_NAMING_CONTRACT" in VIEWER
+    assert "canonical_case: 'snake_case'" in VIEWER
+    assert "compatibility_boundary: 'qt_status_script'" in VIEWER
+    assert "function canonicalDiagnosticValue(value)" in VIEWER
+
+
+def test_readiness_payload_has_no_duplicate_camel_aliases():
+    source = function_source(VIEWER, "structuredWeb3dReadinessFields")
+    keys = declared_keys(source)
+    assert keys
+    assert not [key for key in keys if re.search(r"[A-Z]", key)]
+    assert "canonicalDiagnosticValue({" in source
+    emit = function_source(VIEWER, "emitWeb3dReadinessState")
+    assert "detail = canonicalDiagnosticValue(detail);" in emit
+    assert "const eventDetail = canonicalDiagnosticValue({" in emit
+
+
+def test_failed_canvas_pick_has_one_canonical_copy_per_field():
+    source = function_source(VIEWER, "failedCanvasPickDiagnostic")
+    keys = declared_keys(source)
+    assert keys
+    assert not [key for key in keys if re.search(r"[A-Z]", key)]
+    assert len(keys) == len(set(keys))
+    for key in (
+        "raw_hit_count", "traversed_object_count", "visible_mesh_count",
+        "selectable_owner_count", "registered_render_root_count",
+        "selection_resolution_map_size", "owner_render_root_map_size",
+        "hover_render_root_map_size", "reason_code", "nearest_object_name",
+        "nearest_object_type", "nearest_owner_id", "nearest_diagnostic_reason",
+        "hit_resolutions",
+    ):
+        assert key in keys
+
+
+def test_rejected_pick_records_and_warnings_are_deduplicated():
+    assert "function stableDiagnosticSignature(kind, payload)" in VIEWER
+    assert "state.normalDiagnosticRecords" in VIEWER
+    assert "warnNormalDiagnosticOnce('failed_canvas_pick'" in VIEWER
+    assert "const signature = ['failed_canvas_pick'" not in VIEWER
+
+
+def test_mesh_assembly_and_status_producers_declare_only_canonical_keys():
+    for name in (
+        "collectRenderedMeshDiagnostics", "collectAssemblyRenderDiagnostics",
+        "expandedUrdfVisualReadinessDiagnostics", "updateViewerStatus", "showError",
+    ):
+        source = function_source(VIEWER, name)
+        keys = declared_keys(source)
+        assert not [key for key in keys if re.search(r"[A-Z]", key)], (name, keys)
+        assert "canonicalDiagnosticValue" in source
+    assert "detached_robot_mesh_clusters_count:" not in VIEWER
+
+
+def test_renderer_removes_known_diagnostic_aliases_at_output_boundary():
+    aliases = (
+        "colladaZUpConsoleMessageCount", "robotPreviewLifecycleState",
+        "robotPreviewFailureReason", "robotColladaRootNormalizationCount",
+        "robotVisualWrapperWorldMatrices", "robotVisualMeshWorldBounds",
+        "robotBaseAnchorPrePosition", "robotBaseAnchorPostPosition",
+        "robotBaseAnchorExpectedPosition", "robotBaseAnchorWorldPosition",
+        "robotAnchorDeltaPosition", "robotLinkWorldMatrices",
+        "sourceUrl:", "policyReason:",
+    )
+    for alias in aliases:
+        assert alias not in RENDERER
+    assert "result.diagnostics = canonicalDiagnosticValue(result.diagnostics);" in RENDERER
+    assert "onRobotError?.(err, result.diagnostics)" in RENDERER
+
+
+def test_qt_status_script_is_the_only_narrow_legacy_boundary():
+    start = QT.index('static const char kStatusScript[]')
+    end = QT.index(')JS";', start)
+    script = QT[start:end]
+    assert "External compatibility boundary" in script
+    assert "const readStatus = (canonicalKey, legacyKey, fallbackValue)" in script
+    pairs = re.findall(r"readStatus\('([a-z0-9_]+)', '([A-Za-z0-9]+)'", script)
+    assert pairs
+    assert len({canonical for canonical, _ in pairs}) == len(pairs)
+    required = {
+        "readiness_contract_version", "lifecycle_state", "status_sequence",
+        "builder_revision", "web3d_readiness_state", "viewer_boot_state",
+        "scene_json_loaded", "failed_required_item_count",
+        "required_mesh_failed_count", "expected_physical_item_count",
+        "rendered_physical_item_count", "expected_robot_visual_count",
+        "rendered_robot_visual_count", "failed_robot_visual_count",
+        "expected_robot_link_count", "rendered_robot_link_count",
+        "missing_robot_link_count", "robot_status", "tool_status",
+        "environment_status", "camera_status", "pending_required_loads",
+        "final_lifecycle_state", "readiness_failure_code",
+        "readiness_failure_reason", "failed_stage", "fatal_error", "fatal_stack",
+    }
+    assert required.issubset({canonical for canonical, _ in pairs} | {"lifecycle_state", "pending_required_loads"})
