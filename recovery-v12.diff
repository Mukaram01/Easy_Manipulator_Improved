+function diagnosticSnakeCaseKey(key) {
+  return String(key || '')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1_$2')
+    .replace(/([a-z0-9])([A-Z])/g, '$1_$2')
+    .replace(/-/g, '_')
+    .toLowerCase();
+}
+function canonicalDiagnosticValue(value) {
+  if (Array.isArray(value)) return value.map(canonicalDiagnosticValue);
+  if (!value || typeof value !== 'object') return value;
+  const prototype = Object.getPrototypeOf(value);
+  if (prototype !== Object.prototype && prototype !== null) return value;
+  const output = {};
+  const entries = Object.entries(value).sort(([left], [right]) =>
+    Number(left !== diagnosticSnakeCaseKey(left)) - Number(right !== diagnosticSnakeCaseKey(right)));
+  for (const [key, item] of entries) {
+    const canonicalKey = diagnosticSnakeCaseKey(key);
+    if (Object.prototype.hasOwnProperty.call(output, canonicalKey)) continue;
+    output[canonicalKey] = canonicalDiagnosticValue(item);
+  }
+  return output;
+}
