  # TrajOpt/Tesseract 0.33.x on Humble requires the legacy OSQP 0.6 API
  # (including osqp/auxil.h). Pin OSQP/OsqpEigen to known-compatible refs.
  osqp:
    type: git
    url: https://github.com/osqp/osqp.git
    version: v0.6.3
  osqp-eigen:
    type: git
    url: https://github.com/robotology/osqp-eigen.git
    version: v0.8.0
