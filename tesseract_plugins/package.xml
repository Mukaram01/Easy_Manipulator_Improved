<?xml version="1.0"?>
<package format="3">
  <name>tesseract_plugins</name>
  <version>0.31.0</version>
  <description>Aggregates the available Tesseract collision plugin targets for downstream consumption.</description>
  <maintainer email="levi.armstrong@gmail.com">Levi Armstrong</maintainer>
  <license>Apache 2.0</license>
  <author>Levi Armstrong</author>

  <buildtool_depend>cmake</buildtool_depend>

  <build_depend>ros_industrial_cmake_boilerplate</build_depend>

  <depend>tesseract_collision</depend>
  <depend>tesseract_collision_fcl</depend>
  <depend>tesseract_collision_bullet</depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
