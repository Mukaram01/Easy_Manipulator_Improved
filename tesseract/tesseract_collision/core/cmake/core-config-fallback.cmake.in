# Fallback config for the ${PROJECT_NAME}_core component.
# This file is generated when configure_component() does not emit the
# standard ${PROJECT_NAME}_coreConfig.cmake. It simply re-exports the
# targets that were already generated by the upstream packaging logic.

@CORE_FIND_DEPENDENCIES@

include("\${CMAKE_CURRENT_LIST_DIR}/@CORE_TARGETS_FILENAME@")
