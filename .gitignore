# colcon / ROS2 build artifacts
build/
install/
log/
.colcon/
.ros/

# common dev junk
.vscode/
.idea/
*.swp
*~
.DS_Store

# python
__pycache__/
*.pyc

# C/C++
*.o
*.so
*.a

# generated / cache
.cache/
tmp/


# Third-party dependencies (imported via vcs/.repos; do not commit)
src/descartes_light/
src/ifopt/
src/opw_kinematics/
src/tesseract*/
src/trajopt/

# Do not vendor dependencies in this repo (use tesseract.repos + vcs import)
boost_plugin_loader/
ros_industrial_cmake_boilerplate/
tesseract*/
# Allow the first-party Tesseract backend sources that live inside the package.
!easy_manipulation_deployment/emd_dynamic_safety/src/tesseract/
!easy_manipulation_deployment/emd_dynamic_safety/src/tesseract/*
trajopt*/
ifopt/
opw_kinematics/
descartes_light/
tesseract_external/

# Never commit vendored deps (use tesseract.repos + vcs import)
src/boost_plugin_loader/
src/ros_industrial_cmake_boilerplate/

# Workcell Studio generated scene cache/artifacts
scenes/*/generated/
!scenes/*/generated/.gitkeep

# Workcell Studio Web 3D exports
*.web_scene.json
workcell_studio_web_scene/
