# colcon / ROS2 build artifacts
build/
install/
log/
.colcon/
.ros/

# common dev junk
.vscode/
.idea/
*.swp
*~
.DS_Store

# python
__pycache__/
*.pyc

# C/C++
*.o
*.so
*.a

# generated / cache
.cache/
tmp/


# Third-party dependencies (imported via vcs/.repos; do not commit)
src/descartes_light/
src/ifopt/
src/opw_kinematics/
src/tesseract*/
src/trajopt/

# Do not vendor dependencies in this repo (use tesseract.repos + vcs import)
boost_plugin_loader/
ros_industrial_cmake_boilerplate/
tesseract*/
# Allow the first-party Tesseract backend sources that live inside the package.
!easy_manipulation_deployment/emd_dynamic_safety/src/tesseract/
!easy_manipulation_deployment/emd_dynamic_safety/src/tesseract/*
trajopt*/
ifopt/
opw_kinematics/
descartes_light/
tesseract_external/

# Never commit vendored deps (use tesseract.repos + vcs import)
src/boost_plugin_loader/
src/ros_industrial_cmake_boilerplate/

# Workcell Studio scenes: cells created in Workcell Builder (New Cell) are local to this PC and Git-ignored.
# Only the curated reference library below is tracked; add a scene here deliberately, with its licensed assets.
# (docs/manuals/SCENE_CREATION_WORKFLOW.md, "Where cells are saved")
scenes/*
!scenes/supported_scenes.yaml
# Reference scenes: canonical first/second scenes and the sorting reference.
!scenes/ur5_2f_test/
!scenes/suction_test/
!scenes/ur5_2f_sorting_test/
# Tracked capability scenes, still used by tests and the catalog; retirement candidates (decision pending).
!scenes/ur5_2f_builder_pick_place_demo/
!scenes/ur5_3f_test/
!scenes/ur3_suction_test/
!scenes/ur10_2f_test/
!scenes/ur5_airpick4_test/

# User-imported CAD and its catalog (Asset Library > Import Mesh): this PC's local library, never committed.
workcell_builder/workcell_builder/assets/imported/*
!workcell_builder/workcell_builder/assets/imported/.gitkeep

# Workcell Studio generated scene cache/artifacts
scenes/*/generated/
# Builder build/launch session logs written into a scene
scenes/*/preview_launch/
# Runtime EPD readiness status written by epd_readiness_monitor_node.py
scenes/*/preview/epd_detection_readiness.json
!scenes/*/generated/.gitkeep

# Workcell Studio local authoring backups
scenes/**/*.yaml.bak
scenes/**/*.yml.bak
scenes/**/*.bak.yaml
scenes/**/*.malformed_backup_*

# Workcell Studio Web 3D exports
*.web_scene.json
workcell_studio_web_scene/

# Workcell Studio Web viewer dependencies
workcell_studio_web/viewer/node_modules/

# Generated Workcell Studio URDF metadata
scenes/*/urdf/generated_asset_metadata.yaml
