diff --git a/src/default_capabilities/move_action_capability.cpp b/src/default_capabilities/move_action_capability.cpp
index ec71d95..6c70415 100644
--- a/src/default_capabilities/move_action_capability.cpp
+++ b/src/default_capabilities/move_action_capability.cpp
@@ -96,14 +96,31 @@ void MoveGroupMoveAction::executeMoveCallback(const std::shared_ptr<MGActionGoal
   // @todo: Response messages
   RCLCPP_INFO_STREAM(LOGGER, getActionResultString(action_res->error_code, planned_trajectory_empty,
                                                    goal->get_goal()->planning_options.plan_only));
-  if (action_res->error_code.val == moveit_msgs::msg::MoveItErrorCodes::SUCCESS)
-    goal->succeed(action_res);
-  else if (action_res->error_code.val == moveit_msgs::msg::MoveItErrorCodes::PREEMPTED)
-    goal->canceled(action_res);
-  else
-    goal->abort(action_res);
-
-  setMoveState(IDLE, goal);
+  try
+  {
+    // Make the local goal terminal even after context shutdown. Returning
+    // without that transition would make ServerGoalHandle's destructor try
+    // to cancel and publish a result through the same invalid action server.
+    if (action_res->error_code.val == moveit_msgs::msg::MoveItErrorCodes::SUCCESS)
+      goal->succeed(action_res);
+    else if (action_res->error_code.val == moveit_msgs::msg::MoveItErrorCodes::PREEMPTED)
+      goal->canceled(action_res);
+    else
+      goal->abort(action_res);
+
+    if (rclcpp::ok(node->get_node_base_interface()->get_context()))
+      setMoveState(IDLE, goal);
+  }
+  catch (const std::runtime_error& error)
+  {
+    // SIGINT can invalidate the server while a planning callback is still
+    // running. Result/feedback publication can then fail after the goal's
+    // terminal transition. Do not hide live-context or transition failures.
+    if (rclcpp::ok(node->get_node_base_interface()->get_context()) || goal->is_active())
+      throw;
+    RCLCPP_DEBUG(LOGGER, "Terminal goal publication interrupted by context shutdown: %s", error.what());
+  }
+  setMoveState(IDLE, nullptr);
   preempt_requested_ = false;
 }

